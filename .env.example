# --- Required -----------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
# Free key from https://aistudio.google.com/apikey (only needed with AI_PROVIDER=gemini)
GEMINI_API_KEY=

# --- Optional -----------------------------------------------------------
# Your server ID: makes slash commands show up instantly instead of after a delay.
GUILD_ID=
# Only watch these channels (comma-separated). Empty = every channel.
WATCH_CHANNEL_IDS=
# Never watch these channels (e.g. a #memes or #spam channel).
IGNORE_CHANNEL_IDS=
# Channel where the bot logs every punishment.
LOG_CHANNEL_ID=

# Everyone is watched except bots, the owner, admins, and (if EXEMPT_MODS) anyone
# who can manage messages or time members out. Add more exempt roles here.
EXEMPT_MODS=true
EXEMPT_ROLE_IDS=

# --- Punishments --------------------------------------------------------
# Each offense moves a member one step up this ladder. "kick" kicks them and DMs
# an invite to rejoin after KICK_MINUTES. Past the end, the last step repeats.
PUNISHMENTS=10s,20s,30s,kick
KICK_MINUTES=10
# Offense count goes back to zero after this many hours without an offense (72 = 3 days).
# Reset someone by hand with /spreader reset or the dashboard.
OFFENSE_RESET_HOURS=72
# Delete the spam messages that triggered the punishment.
DELETE_SPAM=true
# Post a short notice in the channel when someone is punished.
ANNOUNCE=true

# --- Detection ----------------------------------------------------------
# GIF spam: GIF_LIMIT GIFs/stickers within GIF_WINDOW_SECONDS.
GIF_LIMIT=4
GIF_WINDOW_SECONDS=60
# Repeats: REPEAT_LIMIT near-identical messages within REPEAT_WINDOW_SECONDS.
REPEAT_LIMIT=3
REPEAT_WINDOW_SECONDS=120

# AI check: an AI judges whether each message contributes. AI_STRIKES "not
# contributing" verdicts within AI_STRIKE_WINDOW_SECONDS count as one offense.
AI_ENABLED=true
# "gemini" = Google's free tier (default). "claude" = Claude Haiku, paid but ~$1 per 10,000 messages.
AI_PROVIDER=gemini
# Leave empty for the default (gemini-3.5-flash-lite / claude-haiku-5-5).
AI_MODEL=
# Only needed with AI_PROVIDER=claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
AI_STRIKES=3
AI_STRIKE_WINDOW_SECONDS=600
# Cap on AI checks per minute, to stay inside the free tier. Extra messages skip the AI check.
AI_MAX_PER_MINUTE=12
# Messages shorter than this skip the AI check ("ok", "ye").
AI_MIN_LENGTH=3
# How many recent channel messages the AI sees as context.
CONTEXT_MESSAGES=15

# --- Dashboard ----------------------------------------------------------
DASHBOARD_ENABLED=true
# 127.0.0.1 = only viewable on this computer. Use 0.0.0.0 to open it to your network,
# and set a password if you do (username: admin).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=
