# --- Required -----------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
# Free key from https://aistudio.google.com/apikey (used for the spam/"not contributing" checks)
GEMINI_API_KEY=
# Free key from https://console.groq.com/keys (used for /settleargument and the AI chat)
GROQ_API_KEY=

# --- Optional -----------------------------------------------------------
# Your server ID: makes slash commands show up instantly instead of after a delay.
GUILD_ID=
# Only watch these channels (comma-separated). Empty = every channel.
WATCH_CHANNEL_IDS=
# Never watch these channels (e.g. a #memes or #spam channel).
IGNORE_CHANNEL_IDS=
# Channel where the bot logs every punishment.
LOG_CHANNEL_ID=

# Everyone is watched except bots, the owner, admins, and (if EXEMPT_MODS) anyone
# who can manage messages or time members out. Add more exempt roles here.
EXEMPT_MODS=true
EXEMPT_ROLE_IDS=

# --- Punishments --------------------------------------------------------
# Each offense moves a member one step up this ladder. "kick" kicks them and DMs
# an invite to rejoin after KICK_MINUTES. Past the end, the last step repeats.
PUNISHMENTS=10s,20s,30s,kick
KICK_MINUTES=10
# Offense count goes back to zero after this many hours without an offense (72 = 3 days).
# Reset someone by hand with /spreader reset or the dashboard.
OFFENSE_RESET_HOURS=72
# Delete the spam messages that triggered the punishment.
DELETE_SPAM=true
# Post a short notice in the channel when someone is punished.
ANNOUNCE=true

# --- Detection ----------------------------------------------------------
# GIF spam: GIF_LIMIT GIFs/stickers within GIF_WINDOW_SECONDS.
GIF_LIMIT=4
GIF_WINDOW_SECONDS=60
# Repeats: REPEAT_LIMIT near-identical messages within REPEAT_WINDOW_SECONDS.
REPEAT_LIMIT=3
REPEAT_WINDOW_SECONDS=120

# AI check: an AI judges whether each message contributes. AI_STRIKES "not
# contributing" verdicts in a row (within AI_STRIKE_WINDOW_SECONDS) count as one
# offense; a message judged normal in between resets the count.
AI_ENABLED=true
# Which AI does these checks: groq (free), gemini (free), openrouter (free, 50/day) or claude
# (paid, ~$1 per 10,000 messages). A fast, cheap model checks every message; Gemini is saved for
# the second opinion below and for /settleargument and mentions, where it's the smarter model.
AI_PROVIDER=groq
# Leave empty for the provider's default model (gemini-3.5-flash-lite, openai/gpt-oss-120b,
# google/gemma-4-31b-it:free, claude-haiku-5-5).
# Every *_MODEL setting can list several models separated by commas. The bot tries them in
# order and uses the first one that answers, so a busy or rate-limited model doesn't break
# anything. Put "provider:" in front to use another provider, e.g. gemini:gemini-3.5-flash-lite
AI_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Asked only when the check above isn't sure (borderline messages, slang or in-jokes it can't place).
# Empty = no second opinion. If every AI_MODEL is rate-limited, the AI check is skipped rather than
# spending this model's allowance (GIF and repeat detection keep working).
AI_UNSURE_PROVIDER=
AI_UNSURE_MODEL=gemini:gemini-3.5-flash-lite
# Only needed if you pick these providers anywhere:
# https://openrouter.ai/keys and https://console.anthropic.com/settings/keys
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_STRIKES=3
AI_STRIKE_WINDOW_SECONDS=600
# Cap on AI checks per minute, to stay inside the free tier. Extra messages skip the AI check.
AI_MAX_PER_MINUTE=12
# Messages shorter than this skip the AI check ("ok", "ye").
AI_MIN_LENGTH=3
# How many recent channel messages the AI sees as context.
CONTEXT_MESSAGES=15

# --- Commands anyone can use --------------------------------------------
# /shutup: each member gets SHUTUP_PER_WEEK uses per rolling 7 days; each one
# times the chosen person out for SHUTUP_SECONDS.
SHUTUP_PER_WEEK=3
SHUTUP_SECONDS=10
# /settleargument (uses the AI): can run once per channel every this many seconds.
SETTLE_COOLDOWN_SECONDS=30
# Which AI settles arguments. Empty = same as AI_PROVIDER. Gemini 3.5 Flash-Lite scores higher than
# gpt-oss-120b on benchmarks but takes ~10s to start answering; the Groq models are backups.
SETTLE_PROVIDER=groq
SETTLE_MODEL=gemini:gemini-3.5-flash-lite,openai/gpt-oss-120b,openai/gpt-oss-20b

# --- AI chat ------------------------------------------------------------
# The bot replies to every message in CHAT_CHANNEL_ID, and to anyone who @mentions
# it or replies to it in any channel. That channel isn't checked for spam.
CHAT_ENABLED=true
CHAT_CHANNEL_ID=
# Which AI chats. Empty = same as SETTLE_PROVIDER. Gemini first, same as mentions (MENTION_MODEL defaults to
# SETTLE_MODEL), so the bot sounds the same everywhere and can look at pictures. The Groq models take over when
# Gemini is busy or out of free requests.
CHAT_PROVIDER=groq
CHAT_MODEL=gemini:gemini-3.5-flash-lite,openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# How many recent messages the bot remembers when chatting. After a restart it reads them back from Discord.
CHAT_CONTEXT_MESSAGES=30
# Which AI answers @mentions and replies to the bot in other channels, where a good answer matters more
# than speed. Empty = the same as SETTLE_PROVIDER / SETTLE_MODEL. Reasoning models think harder here
# (medium) than in the chat channel (low); /settleargument thinks hardest (high).
MENTION_PROVIDER=
MENTION_MODEL=
# Seconds before the bot will answer the same person again (stops one person spamming it).
CHAT_COOLDOWN_SECONDS=4
# Max chat replies + /settleargument uses per minute (Groq free tier allows 30).
CHAT_MAX_PER_MINUTE=20
# The AI's personality, on one line in double quotes. It can only be changed here (restart
# the bot after editing). Empty = a sarcastic, pun-loving gremlin.
PERSONA=

# --- Dashboard ----------------------------------------------------------
DASHBOARD_ENABLED=true
# Keep a log of the messages the AI checked (with its reasoning) and the bot's replies and rulings,
# shown on the dashboard. Entries older than LOG_DAYS are deleted automatically.
LOG_MESSAGES=true
LOG_DAYS=7
# 127.0.0.1 = only viewable on this computer. Use 0.0.0.0 to open it to your network,
# and set a password if you do (username: admin).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=
